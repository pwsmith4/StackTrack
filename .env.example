NODE_ENV=development
PORT=3000
LOCAL_HOST=127.0.0.1
LOCAL_DATA_PATH=.local-data/ledger.json
DATABASE_URL=postgres://stacktrack:stacktrack@localhost:5433/stacktrack
DATABASE_ADMIN_URL=postgres://postgres:stacktrack@localhost:5433/stacktrack
# Required by the containerized Azure API. Use sslmode=require for Azure PostgreSQL.
# DATABASE_URL=postgresql://stacktrack_app:<password>@<server>.postgres.database.azure.com:5432/stacktrack?sslmode=require
# STACKTRACK_TEST_MODE=true
AUTH_MODE=development
CLOCK_WARNING_SECONDS=600
CLOCK_REVIEW_SECONDS=86400
COMPETING_OBSERVATION_SECONDS=120
