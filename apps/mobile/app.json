{
  "expo": {
    "name": "StackTrack",
    "slug": "stacktrack-local",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F6F8",
    "primaryColor": "#00539F",
    "icon": "./assets/stacktrack-app-icon.png",
    "splash": {
      "image": "./assets/stacktrack-logo-tight.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F6F8"
    },
    "android": {
      "package": "org.goodwill.stacktrack.local",
      "adaptiveIcon": {
        "foregroundImage": "./assets/stacktrack-app-icon.png",
        "backgroundColor": "#00294F"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "translucent": false
    },
    "web": {
      "bundler": "metro",
      "name": "StackTrack Mobile"
    }
  }
}
